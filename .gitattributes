* text=auto
*.php text eol=lf
*.css text eol=lf
*.js text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
.htaccess text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary

# Source-only files must not be included by git archive.
# Production packaging uses scripts/build-release.ps1 as an explicit allowlist.
/tests export-ignore
/tests/** export-ignore
/scripts export-ignore
/scripts/** export-ignore
/.github export-ignore
/.github/** export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
*.[mM][dD] export-ignore
*.sql export-ignore
/uploads/demo/gallery-generation.json export-ignore
