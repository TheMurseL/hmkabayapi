# Track only application runtime files and the two Git policy files.
# Tests, scripts, documents, SQL, backups and local tools stay on this machine.
/*
!/.gitignore
!/.gitattributes
!/.htaccess
!/index.php

!/admin/
/admin/**
!/admin/**/
!/admin/**/*.php
!/app/
/app/**
!/app/**/
!/app/**/*.php
!/config/
/config/**
!/config/**/
!/config/**/*.php
!/partials/
/partials/**
!/partials/**/
!/partials/**/*.php
!/views/
/views/**
!/views/**/
!/views/**/*.php

!/assets/
/assets/**
!/assets/**/
!/assets/**/*.css
!/assets/**/*.js
!/assets/**/*.svg
!/assets/**/*.png
!/assets/**/*.jpg
!/assets/**/*.jpeg
!/assets/**/*.webp
!/assets/**/*.ico
!/assets/**/*.woff
!/assets/**/*.woff2
!/assets/**/*.ttf

# Only optimized bundled demo images; live uploads are managed separately.
!/uploads/
/uploads/**
!/uploads/demo/
!/uploads/demo/**/
!/uploads/demo/**/*.webp

# Never allow credentials, private data, or development files in allowed folders.
**/.*/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
credentials.*
secrets.*
*.[mM][dD]
*.sql
*.sql.*
*.dump
*.sqlite
*.sqlite3
*.log
*.bak
*.old
*.orig
*.tmp
*.temp
*.zip
*.7z
*.tar
*.gz
**/tests/
**/scripts/
**/node_modules/
**/vendor/
